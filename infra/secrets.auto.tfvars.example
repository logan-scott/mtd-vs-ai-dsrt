# Copy to `secrets.auto.tfvars` (gitignored) and fill in real values.
# NEVER commit the populated file — it contains the Proxmox API token.
#
# Create a scoped automation token in Proxmox (Datacenter -> Permissions ->
# API Tokens) for user amethyst, grant it the roles needed to manage VMs,
# storage, and SDN/network on node pve2, then paste it below.

proxmox_endpoint     = "https://10.5.0.200:8006/"
proxmox_api_token    = "amethyst@pam!terraform=00000000-0000-0000-0000-000000000000"
proxmox_ssh_username = "amethyst"
proxmox_tls_insecure = true
